{
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.13.0": true
  },
  "author": "Envy Labs (envylabs.com)",
  "description": "Typed, validated construction of known paths and URLs",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-envylabs": "^1.6.1",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-5.5": "npm:typescript@~5.5.4",
    "typescript-eslint": "^8.73.0",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "url",
    "path",
    "route",
    "uri-template",
    "rfc6570",
    "typescript",
    "nextjs",
    "standard-schema",
    "envylabs"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@envylabs/url-to",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envylabs/url-to.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:attw": "attw --pack . --profile esm-only",
    "check:package": "npm run check:publint && npm run check:attw",
    "check:publint": "publint --strict",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:ts5.5": "node node_modules/typescript-5.5/bin/tsc -p tsconfig.ts5.5.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.0.0"
}
