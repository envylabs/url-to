{
  "name": "url-to",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    {
      "source": "url-to-claude-config-${devcontainerId}",
      "target": "/home/node/.claude",
      "type": "volume"
    },
    {
      "source": "url-to-gh-config-${devcontainerId}",
      "target": "/home/node/.config/gh",
      "type": "volume"
    },
    {
      "source": "url-to-node_modules-${devcontainerId}",
      "target": "/workspaces/url-to/node_modules",
      "type": "volume"
    }
  ],
  "postCreateCommand": "sudo chown -R node:node node_modules && npm ci --no-audit --no-fund",
  "remoteEnv": {
    "EDITOR": "code --wait"
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/url-to",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/url-to,type=bind"
}
